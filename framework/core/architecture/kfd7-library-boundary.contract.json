      "symbol": "kungfu_get_api",
      "version": 1,
      "stability": "not-stable-until-export-package-and-qualification",
      "rules": [
        "c-compatible",
        "fixed-width-values",
        "caller-sized-structs",
        "opaque-handles",
        "explicit-release",
        "numeric-status",
        "no-cross-boundary-unwind",
        "unknown-version-fails-closed"
      ]
    },
    "interfaces": [
      {
        "id": "discovery",
        "version": 1,
        "owns": ["runtime-identity", "contracts", "schemas", "capabilities", "interface-versions", "error-dictionary"]
      },
      {
        "id": "stream",
        "version": 1,
        "owns": ["zero-copy-journal-read", "borrowed-buffer-lifetime", "data-plane-metadata"]
      },
      {
        "id": "ledger-action",
        "version": 1,
        "owns": ["fact-episode-operations", "action-binding", "authority-conversion", "occurrence-and-receipts", "query-and-replay"],
        "requiredActionBindingRoots": ["fact-cut", "pursuit", "atlas", "warrant", "candidate-action", "preconditions", "resources"],
        "nonInference": [
          "planned-does-not-imply-authorized",
          "authorized-does-not-imply-occurred",
          "occurred-does-not-imply-admitted",
          "admitted-does-not-imply-pursuit-settled"
        ]
      },
      {
        "id": "maintenance",
        "version": 1,
        "owns": ["diagnostics", "maintenance-plans", "fenced-recovery", "import-export"]
      }
    ],
    "semanticCurrency": {
      "required": ["protocol-id", "protocol-version", "schema-ref", "encoding", "bytes"],
      "json": "named-edge-or-compatibility-encoding-only",
      "rootIdentity": "owned-by-the-versioned-protocol-not-the-abi"
    }
  },
  "compatibility": {
    "retainedSymbols": ["kungfu_embedding_get_api", "kungfu_native_storage_get_api"],
    "retainedVersions": {
      "kungfu_embedding_get_api": [1, 2, 3, 4, 5],
      "kungfu_native_storage_get_api": [1]
    },
    "rules": [
      "no-silent-removal",
      "no-in-place-reinterpretation",
      "old-caller-new-library-fixtures",
      "delegate-only-after-byte-root-error-parity"
    ]
