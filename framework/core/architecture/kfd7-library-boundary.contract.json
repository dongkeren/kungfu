        "disposition": "compatibility-adapter"
      },
      {
        "name": "kungfu_native_storage_get_api",
        "header": "framework/core/src/libkungfu/include/kungfu/native_storage.h",
        "versions": [1],
        "currency": ["operation-name", "json-request", "json-result"],
        "disposition": "compatibility-adapter"
      }
    ],
    "knownGaps": [
      "two-public-bootstraps",
      "legacy-json-operation-currency",
      "json-edge-is-the-only-native-storage-currency",
      "no-action-binding-interface",
      "no-installed-cmake-sdk-coordinate",
      "no-independent-cross-platform-reference-reports"
    ]
  },
  "successorAbi": {
    "status": "planned-not-shipped",
